    {
      "image": 11,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/1f52bf2e-2a4b-4eae-aaa6-067256e49941.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/1f52bf2e-2a4b-4eae-aaa6-067256e49941/full/2000,/0/default.jpg",
      "label": "pp. [20]-[21]",
      "file": "11.jpg",
      "bytes": 936140,
      "sha256": "d0fc0b55f54ee85db9807d77713e9e2fa015cee90b62031696acd409a558100c",
      "native_width": 6528,
      "native_height": 5412,
      "downloaded_width": 2000,
      "downloaded_height": 1658,
      "content_role": "author-text",
      "state": "independent-read-and-source-adjudication",
      "sides": [
        {
          "side": "right",
          "columns": [
            {
              "text": "値却抵千百、自從天主創世、過了四千多年、他纔降"
            },
            {
              "text": "生在世、作了罪人的救主、救主在世上、共有三十三"
            },
            {
              "text": "年、世上的君王、但能管理人的行為、救主耶穌實能"
            },
            {
              "text": "管理人的心志、那時猶太人的官長、妒嫉耶穌、就勾"
            },
            {
              "text": "串惡黨、作出假見證、將他釘死在十字架上、他這一"
            },
            {
              "text": "死、就是償了債了、世上人若能深信耶穌、就可以免"
            },
            {
              "text": "罪、死後同到天堂享福、那赦詔就指得是心中得有"
            },
            {
              "text": "平康的憑據、那不求赦詔的人、不覺自己有罪、輕看"
            },
            {
              "text": "耶穌的救法、那知只一輕看、這罪比諸罪更重、內中"
            }
          ],
          "extras": [
            {
              "type": "running-title",
              "location": "版心",
              "text": "欠債喻言　十八",
              "column_anchor": 9,
              "color": "unknown"
            },
            {
              "type": "name-line",
              "location": "第四欄名線",
              "text": "猶太",
              "column_anchor": 4,
              "color": "unknown"
            }
          ]
        },
        {
          "side": "left",
          "columns": [
            {
              "text": "或有貪戀目前的榮華、暫時不肯信從、或有心中雖"
            },
            {
              "text": "信、恐人指笑攔阻、不敢公然歸服、這都是有罪的、那"
            },
            {
              "text": "一褡褳錢、指得是主賜人的能力、助人專心服事上"
            },
            {
              "text": "主、那大觱篥的聲音、指得是末日的審判、那本債簿"
            },
            {
              "text": "用紅筆塗抹、那紅、指得是耶穌的寶血、信主的人不"
            },
            {
              "text": "怕末日的審判、因為耶穌的寶血、將他的罪洗淨了、"
            },
            {
              "text": "不信的到了末日、沒有悔改的機會、實在是可怕的、"
            },
            {
              "text": "看這書的人、請自己思想、欠主的債不欠、不知死在"
            },
            {
              "text": "何日、應當及早反己悔罪求恩、聖經上說、現今正是"
            }
          ],
          "extras": [
            {
              "type": "running-title",
              "location": "版心",
              "text": "欠債喻言　十九",
              "column_anchor": 9,
              "color": "unknown"
            }
          ]
        }
      ],
      "issues": [],
      "observations": "左面：第四欄「鑼築」同第8幅，後字待核。"
    },
