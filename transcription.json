      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/cdee8fef-9850-4b70-a1ed-07913f77b080.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/cdee8fef-9850-4b70-a1ed-07913f77b080/full/2000,/0/default.jpg",
      "label": "pp. [8]-[9]",
